# .env.example — 환경변수 예시

# 로컬 개발은 이 파일을 .env.local 로 복사해서 사용 (npm run dev)
# 서버 배포는 .env 로 복사해서 사용 (npm start)

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# 쉼표로 구분. 비우면 모든 origin 허용 (개발용)
CORS_ORIGINS=

# false 면 /docs 비활성화 (운영 권장)
SWAGGER_ENABLED=true

# 가드별 JWT 비밀키 (32자 이상, 가드마다 다른 값). 생성: openssl rand -base64 48
USER_JWT_SECRET=
ADMIN_JWT_SECRET=

# DB 접속 정보 (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
