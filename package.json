{
  "name": "fastify-scaffolding-example",
  "version": "1.0.0",
  "description": "Fastify 5 + TypeScript + TypeBox scaffolding reference",
  "scripts": {
    "test": "vitest",
    "dev": "tsx watch --env-file-if-exists=.env.local src/server.ts",
    "build": "tsup",
    "prebuild": "npm run typecheck && npm run check",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "check": "biome check",
    "check:fix": "biome check --write",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/db/migrate.ts up",
    "db:migrate:down": "tsx --env-file-if-exists=.env.local src/db/migrate.ts down",
    "db:seed": "tsx --env-file-if-exists=.env.local src/db/seeds/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "jose": "^6.2.12",
    "kysely": "^0.29.6",
    "mysql2": "^3.24.5",
    "typebox": "^1.3.36"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "pino-pretty": "^13.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
